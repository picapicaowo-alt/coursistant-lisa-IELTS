#!/usr/bin/env bash
set -euo pipefail

dnf update -y
dnf install -y amazon-cloudwatch-agent nginx jq

cat >/etc/coursistant-runtime.env <<'EOF'
AWS_REGION=${aws_region}
OPENAI_SECRET_NAME=${openai_secret_name}
APP_SECRET_NAME=${app_secret_name}
EOF
chmod 0640 /etc/coursistant-runtime.env

cat >/etc/nginx/conf.d/coursistant-placeholder.conf <<'EOF'
server {
  listen ${app_port};
  server_name _;

  location = /health {
    access_log off;
    default_type application/json;
    return 200 '{"status":"ready","service":"coursistant-ielts-infrastructure"}';
  }

  location / {
    default_type application/json;
    return 503 '{"status":"awaiting-backend-deployment"}';
  }
}
EOF

rm -f /etc/nginx/conf.d/default.conf
systemctl enable --now nginx

cat >/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'EOF'
{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/cloud-init-output.log",
            "log_group_name": "${log_group_prefix}/cloud-init",
            "log_stream_name": "{instance_id}"
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "${log_group_prefix}/nginx",
            "log_stream_name": "{instance_id}"
          }
        ]
      }
    }
  },
  "metrics": {
    "append_dimensions": {
      "AutoScalingGroupName": "$${aws:AutoScalingGroupName}",
      "InstanceId": "$${aws:InstanceId}"
    },
    "metrics_collected": {
      "disk": {
        "measurement": ["used_percent"],
        "metrics_collection_interval": 60,
        "resources": ["/"]
      },
      "mem": {
        "measurement": ["mem_used_percent"],
        "metrics_collection_interval": 60
      }
    }
  }
}
EOF

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config \
  -m ec2 \
  -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
