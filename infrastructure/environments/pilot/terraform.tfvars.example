aws_region  = "ap-northeast-1"
expected_account_id = "658424472610"
environment = "pilot"
owner       = "coursistant-platform"

vpc_cidr          = "10.42.0.0/16"
enable_nat_gateway = true

instance_type        = "m7i.xlarge"
root_volume_size_gib = 100
app_port              = 8080
health_check_path     = "/health"

min_size         = 1
desired_capacity = 1
max_size         = 2

# The pilot certificate is issued and both Namecheap CNAME records are active.
domain_name  = "api-cn.xlearnedu.com"
enable_https = true

# The us-east-1 certificate is issued and the Namecheap validation CNAME is active.
frontend_domain_name          = "app.xlearnedu.com"
enable_frontend_custom_domain = true

cache_engine_version          = "8.2"
cache_node_type               = "cache.t4g.micro"
cache_port                    = 6379
cache_snapshot_retention_days = 1
cache_auth_token_version       = 1

# Exact origin for direct browser-to-S3 uploads.
cors_allowed_origins = ["https://app.xlearnedu.com"]

waf_rate_limit    = 2000
monthly_budget_usd = 400

# Supply actual recipients only in an untracked terraform.tfvars file or CI variable.
budget_notification_emails = []
