VITE_BASE_PROTOCOL=https
VITE_BASE_DOMAIN=api-cn.xlearnedu.com
VITE_BASE_PORT=443
VITE_BASE_PATH=/api

# Tokyo LMS uses a dedicated API origin with credentialed CORS.
# Deployment requirements: ../docs/tokyo-frontend-deployment.md.
VITE_API_DOMAIN_NAME=${VITE_BASE_PROTOCOL}://${VITE_BASE_DOMAIN}${VITE_BASE_PATH}
VITE_PROFILE_API_DOMAIN_NAME=${VITE_API_DOMAIN_NAME}
VITE_PROFILE_API_AVATAR_DOMAIN_NAME=${VITE_API_DOMAIN_NAME}
VITE_SIGNUP_API_DOMAIN_NAME=${VITE_API_DOMAIN_NAME}
VITE_CHAT_API_DOMAIN_NAME=${VITE_API_DOMAIN_NAME}
VITE_COURSE_API_DOMAIN_NAME=${VITE_API_DOMAIN_NAME}
VITE_TOKEN_CHECK_API_DOMAIN_NAME=${VITE_API_DOMAIN_NAME}
VITE_ANNOUNCEMENT_API_DOMAIN_NAME=${VITE_API_DOMAIN_NAME}
VITE_ASSIGNMENT_API_DOMAIN_NAME=${VITE_API_DOMAIN_NAME}
VITE_CALENDAR_API_DOMAIN_NAME=${VITE_API_DOMAIN_NAME}
VITE_GROUPING_API_DOMAIN_NAME=${VITE_API_DOMAIN_NAME}


# Independent service paths are retained until Tokyo public origins are
# confirmed. Do not infer that these services share the LMS API origin.
VITE_AI_AGENT_API_DOMAIN_NAME=/ai-agent
VITE_STUDY_SUPPORT_API_DOMAIN_NAME=/study-support
VITE_VOCABULARY_API_DOMAIN_NAME=/vocabulary-api
